@HotelListing.Api_HostAddress = https://localhost:7142



//OLD ENDPOINT PROCESS ---------------------------------------------
GET {{HotelListing.Api_HostAddress}}/api/hotels

###

POST {{HotelListing.Api_HostAddress}}/api/hotels
Content-Type: application/json
{
  "name": "Test",
  "address": "123 Main St",
  "rating": 4.5
}
###

@id=1
DELETE {{HotelListing.Api_HostAddress}}/api/hotels/{{id}}

###

GET {{HotelListing.Api_HostAddress}}/api/hotels/{{id}}

###

PUT {{HotelListing.Api_HostAddress}}/api/hotels/{{id}}
Content-Type: application/json
{
  "id": 1,
  "name": "Test Hotel",
  "address": "123 Main St",
  "rating": 4.5
}
###
//-------------------------------------------------------------------








@id=7

//Get all countries
GET {{HotelListing.Api_HostAddress}}/api/countries

###



//Add new country
POST {{HotelListing.Api_HostAddress}}/api/countries
Content-Type: application/json
{
  "name": "Test Country",
  "shortname": "IC"
}
###



//Delete a specific country
DELETE {{HotelListing.Api_HostAddress}}/api/countries/{{id}}

###



//Get a specific country
GET {{HotelListing.Api_HostAddress}}/api/countries/{{id}}

###



//Update a specific country
PUT {{HotelListing.Api_HostAddress}}/api/countries/{{id}}
Content-Type: application/json

{
  "countryId": 8,
  "name": "Jamaica",
  "shortname": "JM"
}
###



//Get all hotels
GET {{HotelListing.Api_HostAddress}}/api/hotels

###



//Add a new hotel
POST {{HotelListing.Api_HostAddress}}/api/hotels
Content-Type: application/json

{
  "Name": "Test",
  "Address": "123",
  "Rating": 4.5,
  "CountryId": 8
}
###



//Delete a specific hotel
DELETE {{HotelListing.Api_HostAddress}}/api/hotels/{{id}}

###



//Get a specific hotel
GET {{HotelListing.Api_HostAddress}}/api/hotels/{{id}}

###



//Update a specific hotel
PUT {{HotelListing.Api_HostAddress}}/api/hotels/{{id}}
Content-Type: application/json

{
  "Id": 7,
  "Name": "Ocean Coral",
  "Address": "Trelawny, Jamaica",
  "Rating": 4.5,
  "CountryId": 7
}
###
